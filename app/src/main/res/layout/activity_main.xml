<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/StatTitle"
            android:layout_marginTop="16dp"
            android:text="@string/percentage" />

        <TextView
            android:id="@+id/batteryPercentageTextView"
            style="@style/StatValue"
            tools:text="61" />

        <TextView
            style="@style/StatTitle"
            android:text="@string/current" />

        <TextView
            android:id="@+id/chargeAmperTextView"
            style="@style/StatValue"
            tools:text="357421 uA" />

        <TextView
            style="@style/StatTitle"
            android:text="@string/battery_temp" />

        <TextView
            android:id="@+id/batteryTempTextView"
            style="@style/StatValue"
            tools:text="26.0 °C" />

        <TextView
            style="@style/StatTitle"
            android:text="@string/voltage" />

        <TextView
            android:id="@+id/voltageTextView"
            style="@style/StatValue"
            tools:text="3989.0 mV" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/alarmSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/charge_alarm"
            android:textColor="@color/colorForeground"
            android:textSize="24sp" />

        <EditText
            android:id="@+id/alarmPercentageEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:ems="10"
            android:hint="@string/charge_until"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3"
            android:textColor="@color/colorForeground"
            android:textColorHint="@color/colorAccent"
            android:textSize="18sp"
            tools:targetApi="o" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dechargeImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/discharging"
                app:srcCompat="@drawable/ic_decharge" />

            <ImageView
                android:id="@+id/acChargeImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/ac_charger"
                app:srcCompat="@drawable/ic_ac_charger" />

            <ImageView
                android:id="@+id/usbChargeImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/usb_charger"
                app:srcCompat="@drawable/ic_usb_charger" />

            <ImageView
                android:id="@+id/wirelessChargeImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/wireless_charger"
                app:srcCompat="@drawable/ic_wireless_charger" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/infoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/info" />

            <Button
                android:id="@+id/usageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/usage" />

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
